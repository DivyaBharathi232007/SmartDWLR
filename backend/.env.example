# Copy to .env and adjust for your MySQL server
USE_MYSQL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_dwlr

# SMS / alert delivery (Twilio)
# Real SMS sending only works when all of these are filled with live values.
# If you are on a Twilio trial account, both the From and To numbers must be verified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=

# Optional: override the full connection string directly
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/smart_dwlr
